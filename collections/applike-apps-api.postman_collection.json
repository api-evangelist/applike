        {
          "id": "e496545d-b649-434a-913e-501979b6f88a",
          "name": "Create app",
          "request": {
            "name": "Create app",
            "description": {
              "content": "Create an app.\n\n:::info\n\nWe validate the following constraints when creating an app:\n\n- The bundle ID must be unique to your organization, though multiple apps within your organization can have the same bundle ID if the platform is different.\n- A (bundle ID, platform) pair must be unique within your organization.\n- A (name, platform) pair must be unique within your organization.\n- The store ID must be unique across all organizations.\n\n:::",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "management",
                "v1",
                "app"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bundleId\": \"<string>\",\n  \"iconUrl\": \"<string>\",\n  \"name\": \"<string>\",\n  \"platform\": \"<string>\",\n  \"storeId\": \"<string>\"\n}",
