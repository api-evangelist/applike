{
  "opencollection": "1.0.0",
  "info": {
    "name": "Management App Partner Connection API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "App Partner Connection",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get app partner connection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.justtrack.io/management/v1/app/:appId/connection/:partnerId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "justtrack's identifier for the app"
              },
              {
                "name": "partnerId",
                "value": "",
                "type": "path",
                "description": "justtrack's identifier for the advertising partner"
              }
            ]
          },
          "docs": "Get data for existing app partner connection."
        },
        {
          "info": {
            "name": "Connect partner",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.justtrack.io/management/v1/app/:appId/connection/:partnerId",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "justtrack's identifier for the app"
              },
              {
                "name": "partnerId",
                "value": "",
                "type": "path",
                "description": "justtrack's identifier for the advertising partner"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Connect your app to a partner. If this app-partner connection already exists, update the connection details."
        }
      ]
    }
  ],
  "bundled": true
}