        {
          "id": "c38be64b-890b-49dd-8d00-3f77aec6fc84",
          "name": "Send a batch of app events to justtrack",
          "request": {
            "name": "Send a batch of app events to justtrack",
            "description": {
              "content": "Sends batches of batches of events where each inner batch is for a single app and user.\nFollows a bulk processing paradigm where individual AppEventBatches in the InputBatch are processed\nindependently from each other. If an AppEventBatch fails to be processed, this does not affect the processing\nof the other AppEventBatches in the InputBatch. For all AppEventBatches that fail an individual error status is\nset for its batchId for the \"207\" status code. An individual AppEventBatch is processed \"all or nothing\".\nAfter acceptance of a batch, there is delayed processing of it in subsequent components where additional validation happens.\nThis means that even though a batch was successfully accepted, not necessarily all events will pass processing.\nThis subsequent processing includes but is not limited to:\n- deduplication\n- additional semantic validation\n- user identity resolution\nUser Identity is determined once for the whole batch for an app user combination, using the newest information which predates the newest event in the batch.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appevents",
                "v1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"batchId\": \"<uuid>\",\n    \"app\": {\n      \"storeId\": \"<string>\",\n      \"version\": {\n        \"code\": \"<string>\",\n        \"name\": \"<string>\"\n      }\n    },\n    \"user\": {},\n    \"events\": []\n  },\n  {\n    \"batchId\": \"<uuid>\",\n    \"app\": {\n      \"storeId\": \"<string>\",\n      \"version\": {\n        \"code\": \"<string>\",\n        \"name\": \"<string>\"\n      }\n    },\n    \"user\": {},\n    \"events\": []\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
